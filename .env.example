# Copy this file to .env and add your own key. .env is ignored by git, so the
# key stays on your machine. Never put a real key in this file.
#
# With no key, Jalboot still runs: LLM_MODE=mock uses scripted replies.

# mock: scripted replies, no key, no network. llm: a real model.
LLM_MODE=mock

# groq, or compatible for any other server that speaks the OpenAI API.
LLM_PROVIDER=groq
LLM_API_KEY=
# LLM_API_KEY_ENV=NAME_OF_ANOTHER_VARIABLE_THAT_HOLDS_THE_KEY
# LLM_BASE_URL=
LLM_MODEL=openai/gpt-oss-20b

# Adds dense embeddings to search. Needs the embeddings extra and downloads a model.
# Search works without it. Measured results are in eval/results/retrieval-dev.json.
# EMBEDDINGS=e5-small

# Password for the demo desk accounts, set when the world is first generated. Outside
# production it defaults to jalboot-local-demo. Production refuses to start without it.
# DEMO_STAFF_PASSWORD=

# SQLite is used when this is empty.
# DATABASE_URL=postgresql+psycopg://jalboot:change-me@localhost:5432/jalboot

# Required in production, at least 32 characters.
# SECRET_KEY=
# ENVIRONMENT=production
# COOKIE_SECURE=true
# SHOW_SIMULATED_OTP=false

# Other origins that may call the API with cookies, separated by commas. Outside
# production this defaults to the Vite dev server on port 5173.
# ALLOWED_ORIGINS=https://support.example.com
