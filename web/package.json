{
  "name": "jalboot-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Customer chat and support desk for a fictional Qatar delivery app. All data is invented.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:demo": "vite build --mode demo --outDir dist-demo",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node e2e/run.mjs",
    "e2e:live": "node e2e/live-check.mjs"
  },
  "dependencies": {
    "@fontsource-variable/alexandria": "5.3.0",
    "@fontsource-variable/changa": "5.3.0",
    "@fontsource/dm-mono": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "puppeteer-core": "25.16.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
