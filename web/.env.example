# mock: in-browser fake backend. Runs with no server. This is the default.
# demo: plays back recorded conversations. Use this for GitHub Pages.
# live: talks to the FastAPI backend described in API.md.
VITE_API_MODE=mock

# REST prefix used in live mode. Can be a full URL if the API is on another host.
VITE_API_BASE=/api/v1

# Path the site is served from. GitHub Pages needs /<repo-name>/.
VITE_BASE_PATH=/

# Dev server proxy target for /api in live mode.
VITE_PROXY_TARGET=http://127.0.0.1:8000
